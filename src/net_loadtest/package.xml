<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>net_loadtest</name>
  <version>0.1.0</version>
  <description>Staged ROS2/DDS network load test: ramp per-group traffic, measure
    per-port and switch-aggregate bps from host NIC counters, find the loss onset.</description>
  <maintainer email="dlwotjraks@gmail.com">Seooooooogi</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
